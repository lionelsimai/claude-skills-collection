{
  "name": "ambassador-brief-template",
  "display_name": "Ambassador Brief Template",
  "description": "Render an ambassador brief from supplied campaign facts.",
  "category": "Ambassadors",
  "domain": "Community",
  "version": "1.0.0",
  "author": {
    "name": "Lionel Sim",
    "url": "https://sg.linkedin.com/in/lionelshen"
  },
  "license": "MIT",
  "tools": [
    {
      "name": "ambassador_brief_template",
      "description": "Render an ambassador brief from supplied campaign facts.",
      "kind": "template",
      "inputSchema": {
        "type": "object",
        "properties": {
          "facts": {
            "type": "object",
            "description": "Supplied facts only, keys include: campaign_goal, key_message_supplied_by_user, assets, do_and_do_not, deadline"
          }
        },
        "required": [
          "facts"
        ]
      },
      "sample_input": {
        "facts": {
          "campaign_goal": "[supplied: campaign goal]",
          "key_message_supplied_by_user": "[supplied: key message supplied by user]",
          "assets": "[supplied: assets]"
        }
      },
      "output": {
        "plugin": "ambassador-brief-template",
        "tool": "ambassador_brief_template",
        "kind": "template",
        "result": "object (shape varies by kind, see README)",
        "guardrails": "object \u2014 present on every result"
      }
    }
  ],
  "handler": {
    "type": "template",
    "config": {
      "items": [
        "campaign goal",
        "key message supplied by user",
        "assets",
        "do and do not",
        "deadline"
      ]
    }
  },
  "guardrails": {
    "no_fabrication": true,
    "draft_only_for_generative_tools": true,
    "human_approval_required": true,
    "no_auto_send": true,
    "use_supplied_facts_only": true
  },
  "keywords": [
    "ambassadors",
    "community",
    "template"
  ]
}
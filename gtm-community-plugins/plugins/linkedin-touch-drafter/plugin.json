{
  "name": "linkedin-touch-drafter",
  "display_name": "LinkedIn Touch Drafter",
  "description": "Draft a LinkedIn touch from a supplied shared context only. Draft only.",
  "category": "Outreach & Sequences",
  "domain": "GTM",
  "version": "1.0.0",
  "author": {
    "name": "Lionel Sim",
    "url": "https://sg.linkedin.com/in/lionelshen"
  },
  "license": "MIT",
  "tools": [
    {
      "name": "linkedin_touch_drafter",
      "description": "Draft a LinkedIn touch from a supplied shared context only. Draft only.",
      "kind": "template",
      "inputSchema": {
        "type": "object",
        "properties": {
          "facts": {
            "type": "object",
            "description": "Supplied facts only, keys include: shared_context, specific_observation, useful_resource, open_question"
          }
        },
        "required": [
          "facts"
        ]
      },
      "sample_input": {
        "facts": {
          "shared_context": "[supplied: shared context]",
          "specific_observation": "[supplied: specific observation]",
          "useful_resource": "[supplied: useful resource]"
        }
      },
      "output": {
        "plugin": "linkedin-touch-drafter",
        "tool": "linkedin_touch_drafter",
        "kind": "template",
        "result": "object (shape varies by kind, see README)",
        "guardrails": "object \u2014 present on every result"
      }
    }
  ],
  "handler": {
    "type": "template",
    "config": {
      "items": [
        "shared context",
        "specific observation",
        "useful resource",
        "open question"
      ]
    }
  },
  "guardrails": {
    "no_fabrication": true,
    "draft_only_for_generative_tools": true,
    "human_approval_required": true,
    "no_auto_send": true,
    "use_supplied_facts_only": true
  },
  "keywords": [
    "outreach & sequences",
    "gtm",
    "template"
  ]
}
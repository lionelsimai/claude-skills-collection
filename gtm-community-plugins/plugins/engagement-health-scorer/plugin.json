{
  "name": "engagement-health-scorer",
  "display_name": "Engagement Health Scorer",
  "description": "Score community engagement health from supplied metrics.",
  "category": "Engagement",
  "domain": "Community",
  "version": "1.0.0",
  "author": {
    "name": "Lionel Sim",
    "url": "https://sg.linkedin.com/in/lionelshen"
  },
  "license": "MIT",
  "tools": [
    {
      "name": "engagement_health_scorer",
      "description": "Score community engagement health from supplied metrics.",
      "kind": "score",
      "inputSchema": {
        "type": "object",
        "properties": {
          "metrics": {
            "type": "object",
            "description": "Scores 0-100 keyed by: active_member_rate, posts_per_week, reply_rate, event_attendance, new_member_activation"
          }
        },
        "required": [
          "metrics"
        ]
      },
      "sample_input": {
        "metrics": {
          "active_member_rate": 70,
          "posts_per_week": 70,
          "reply_rate": 70,
          "event_attendance": 70,
          "new_member_activation": 70
        }
      },
      "output": {
        "plugin": "engagement-health-scorer",
        "tool": "engagement_health_scorer",
        "kind": "score",
        "result": "object (shape varies by kind, see README)",
        "guardrails": "object \u2014 present on every result"
      }
    }
  ],
  "handler": {
    "type": "score",
    "config": {
      "items": [
        "active member rate",
        "posts per week",
        "reply rate",
        "event attendance",
        "new member activation"
      ]
    }
  },
  "guardrails": {
    "no_fabrication": true,
    "draft_only_for_generative_tools": true,
    "human_approval_required": true,
    "no_auto_send": true,
    "use_supplied_facts_only": true
  },
  "keywords": [
    "engagement",
    "community",
    "score"
  ]
}
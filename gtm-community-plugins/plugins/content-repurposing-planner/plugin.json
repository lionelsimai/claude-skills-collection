{
  "name": "content-repurposing-planner",
  "display_name": "Content Repurposing Planner",
  "description": "Plan repurposing one supplied asset into multiple formats.",
  "category": "Content & Thought Leadership",
  "domain": "GTM",
  "version": "1.0.0",
  "author": {
    "name": "Lionel Sim",
    "url": "https://sg.linkedin.com/in/lionelshen"
  },
  "license": "MIT",
  "tools": [
    {
      "name": "content_repurposing_planner",
      "description": "Plan repurposing one supplied asset into multiple formats.",
      "kind": "plan",
      "inputSchema": {
        "type": "object",
        "properties": {
          "goal": {
            "type": "string"
          },
          "timeframe_days": {
            "type": "integer"
          }
        },
        "required": [
          "goal"
        ]
      },
      "sample_input": {
        "goal": "Improve results next quarter with a fictional example team",
        "timeframe_days": 30
      },
      "output": {
        "plugin": "content-repurposing-planner",
        "tool": "content_repurposing_planner",
        "kind": "plan",
        "result": "object (shape varies by kind, see README)",
        "guardrails": "object \u2014 present on every result"
      }
    }
  ],
  "handler": {
    "type": "plan",
    "config": {
      "items": [
        "pick anchor asset",
        "extract clips",
        "extract quotes",
        "write short post",
        "schedule newsletter section"
      ]
    }
  },
  "guardrails": {
    "no_fabrication": true,
    "draft_only_for_generative_tools": true,
    "human_approval_required": true,
    "no_auto_send": true,
    "use_supplied_facts_only": true
  },
  "keywords": [
    "content & thought leadership",
    "gtm",
    "plan"
  ]
}
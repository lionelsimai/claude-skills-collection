        "result": "object (shape varies by kind, see README)",
        "guardrails": "object \u2014 present on every result"
      }
    }
  ],
  "handler": {
    "type": "plan",
    "config": {
      "items": [
        "select seed accounts",
        "extract shared traits",
        "exclude existing customers",
        "build search criteria",
        "validate sample size"
      ]
    }
  },
  "guardrails": {
    "no_fabrication": true,
    "draft_only_for_generative_tools": true,
    "human_approval_required": true,

{
  "name": "icp-fit-scorer",
  "display_name": "ICP Fit Scorer",
  "description": "Score an account against your ideal customer profile on five weighted criteria.",
  "category": "ICP & Market Research",
  "domain": "GTM",
  "version": "1.0.0",
  "author": {
    "name": "Lionel Sim",
    "url": "https://sg.linkedin.com/in/lionelshen"
  },
  "license": "MIT",
  "tools": [
    {
      "name": "icp_fit_scorer",
      "description": "Score an account against your ideal customer profile on five weighted criteria.",
      "kind": "score",
      "inputSchema": {
        "type": "object",
        "properties": {
          "metrics": {
            "type": "object",
            "description": "Scores 0-100 keyed by: company_size_fit, industry_match, geography_fit, technology_fit, buying_signal_strength"
          }
        },
        "required": [
          "metrics"
        ]
      },
      "sample_input": {
        "metrics": {
          "company_size_fit": 70,
          "industry_match": 70,
          "geography_fit": 70,
          "technology_fit": 70,
          "buying_signal_strength": 70
        }
      },
      "output": {
        "plugin": "icp-fit-scorer",
        "tool": "icp_fit_scorer",
        "kind": "score",
        "result": "object (shape varies by kind, see README)",
        "guardrails": "object \u2014 present on every result"
      }
    }
  ],
  "handler": {
    "type": "score",
    "config": {
      "items": [
        "company size fit",
        "industry match",
        "geography fit",
        "technology fit",
        "buying signal strength"
      ]
    }
  },
  "guardrails": {
    "no_fabrication": true,
    "draft_only_for_generative_tools": true,
    "human_approval_required": true,
    "no_auto_send": true,
    "use_supplied_facts_only": true
  },
  "keywords": [
    "icp & market research",
    "gtm",
    "score"
  ]
}
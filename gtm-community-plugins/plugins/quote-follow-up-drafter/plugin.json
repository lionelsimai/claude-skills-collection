{
  "name": "quote-follow-up-drafter",
  "display_name": "Quote Follow-up Drafter",
  "description": "Draft a quote follow-up from supplied quote facts. Draft only.",
  "category": "Proposals & Pricing",
  "domain": "GTM",
  "version": "1.0.0",
  "author": {
    "name": "Lionel Sim",
    "url": "https://sg.linkedin.com/in/lionelshen"
  },
  "license": "MIT",
  "tools": [
    {
      "name": "quote_follow_up_drafter",
      "description": "Draft a quote follow-up from supplied quote facts. Draft only.",
      "kind": "template",
      "inputSchema": {
        "type": "object",
        "properties": {
          "facts": {
            "type": "object",
            "description": "Supplied facts only, keys include: quote_reference, decision_blocker_help, deadline_reminder, next_step"
          }
        },
        "required": [
          "facts"
        ]
      },
      "sample_input": {
        "facts": {
          "quote_reference": "[supplied: quote reference]",
          "decision_blocker_help": "[supplied: decision blocker help]",
          "deadline_reminder": "[supplied: deadline reminder]"
        }
      },
      "output": {
        "plugin": "quote-follow-up-drafter",
        "tool": "quote_follow_up_drafter",
        "kind": "template",
        "result": "object (shape varies by kind, see README)",
        "guardrails": "object \u2014 present on every result"
      }
    }
  ],
  "handler": {
    "type": "template",
    "config": {
      "items": [
        "quote reference",
        "decision blocker help",
        "deadline reminder",
        "next step"
      ]
    }
  },
  "guardrails": {
    "no_fabrication": true,
    "draft_only_for_generative_tools": true,
    "human_approval_required": true,
    "no_auto_send": true,
    "use_supplied_facts_only": true
  },
  "keywords": [
    "proposals & pricing",
    "gtm",
    "template"
  ]
}
{
  "name": "top-contributor-spotlight-template",
  "display_name": "Top Contributor Spotlight Template",
  "description": "Render a contributor spotlight from supplied facts only.",
  "category": "Engagement",
  "domain": "Community",
  "version": "1.0.0",
  "author": {
    "name": "Lionel Sim",
    "url": "https://sg.linkedin.com/in/lionelshen"
  },
  "license": "MIT",
  "tools": [
    {
      "name": "top_contributor_spotlight_template",
      "description": "Render a contributor spotlight from supplied facts only.",
      "kind": "template",
      "inputSchema": {
        "type": "object",
        "properties": {
          "facts": {
            "type": "object",
            "description": "Supplied facts only, keys include: member_name_supplied_by_user, contribution, quote_supplied_by_user, thank_you"
          }
        },
        "required": [
          "facts"
        ]
      },
      "sample_input": {
        "facts": {
          "member_name_supplied_by_user": "[supplied: member name supplied by user]",
          "contribution": "[supplied: contribution]",
          "quote_supplied_by_user": "[supplied: quote supplied by user]"
        }
      },
      "output": {
        "plugin": "top-contributor-spotlight-template",
        "tool": "top_contributor_spotlight_template",
        "kind": "template",
        "result": "object (shape varies by kind, see README)",
        "guardrails": "object \u2014 present on every result"
      }
    }
  ],
  "handler": {
    "type": "template",
    "config": {
      "items": [
        "member name supplied by user",
        "contribution",
        "quote supplied by user",
        "thank you"
      ]
    }
  },
  "guardrails": {
    "no_fabrication": true,
    "draft_only_for_generative_tools": true,
    "human_approval_required": true,
    "no_auto_send": true,
    "use_supplied_facts_only": true
  },
  "keywords": [
    "engagement",
    "community",
    "template"
  ]
}
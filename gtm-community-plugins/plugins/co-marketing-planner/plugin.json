{
  "name": "co-marketing-planner",
  "display_name": "Co-marketing Planner",
  "description": "Plan a co-marketing activity with a partner from a stated goal.",
  "category": "Sponsors & Partners",
  "domain": "GTM",
  "version": "1.0.0",
  "author": {
    "name": "Lionel Sim",
    "url": "https://sg.linkedin.com/in/lionelshen"
  },
  "license": "MIT",
  "tools": [
    {
      "name": "co_marketing_planner",
      "description": "Plan a co-marketing activity with a partner from a stated goal.",
      "kind": "plan",
      "inputSchema": {
        "type": "object",
        "properties": {
          "goal": {
            "type": "string"
          },
          "timeframe_days": {
            "type": "integer"
          }
        },
        "required": [
          "goal"
        ]
      },
      "sample_input": {
        "goal": "Improve results next quarter with a fictional example team",
        "timeframe_days": 30
      },
      "output": {
        "plugin": "co-marketing-planner",
        "tool": "co_marketing_planner",
        "kind": "plan",
        "result": "object (shape varies by kind, see README)",
        "guardrails": "object \u2014 present on every result"
      }
    }
  ],
  "handler": {
    "type": "plan",
    "config": {
      "items": [
        "joint audience",
        "shared asset",
        "channel split",
        "owner per side",
        "success metric"
      ]
    }
  },
  "guardrails": {
    "no_fabrication": true,
    "draft_only_for_generative_tools": true,
    "human_approval_required": true,
    "no_auto_send": true,
    "use_supplied_facts_only": true
  },
  "keywords": [
    "sponsors & partners",
    "gtm",
    "plan"
  ]
}
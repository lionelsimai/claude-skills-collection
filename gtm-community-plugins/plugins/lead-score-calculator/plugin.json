      "sample_input": {
        "metrics": {
          "firmographic_fit": 70,
          "engagement_recency": 70,
          "page_intent": 70,
          "role_seniority": 70,
          "company_growth": 70
        }
      },
      "output": {
        "plugin": "lead-score-calculator",
        "tool": "lead_score_calculator",
        "kind": "score",
        "result": "object (shape varies by kind, see README)",
        "guardrails": "object \u2014 present on every result"
      }
    }
  ],
  "handler": {
    "type": "score",
    "config": {
      "items": [
        "firmographic fit",
        "engagement recency",
        "page intent",
        "role seniority",
        "company growth"
      ]
    }
  },
  "guardrails": {
    "no_fabrication": true,
    "draft_only_for_generative_tools": true,
    "human_approval_required": true,

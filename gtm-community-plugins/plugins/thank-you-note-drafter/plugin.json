{
  "name": "thank-you-note-drafter",
  "display_name": "Thank-you Note Drafter",
  "description": "Draft a thank-you note from supplied facts. Draft only.",
  "category": "Speakers & Sponsors",
  "domain": "Community",
  "version": "1.0.0",
  "author": {
    "name": "Lionel Sim",
    "url": "https://sg.linkedin.com/in/lionelshen"
  },
  "license": "MIT",
  "tools": [
    {
      "name": "thank_you_note_drafter",
      "description": "Draft a thank-you note from supplied facts. Draft only.",
      "kind": "template",
      "inputSchema": {
        "type": "object",
        "properties": {
          "facts": {
            "type": "object",
            "description": "Supplied facts only, keys include: specific_contribution, audience_impact_supplied_by_user, photo_or_recording_link, future_invite"
          }
        },
        "required": [
          "facts"
        ]
      },
      "sample_input": {
        "facts": {
          "specific_contribution": "[supplied: specific contribution]",
          "audience_impact_supplied_by_user": "[supplied: audience impact supplied by user]",
          "photo_or_recording_link": "[supplied: photo or recording link]"
        }
      },
      "output": {
        "plugin": "thank-you-note-drafter",
        "tool": "thank_you_note_drafter",
        "kind": "template",
        "result": "object (shape varies by kind, see README)",
        "guardrails": "object \u2014 present on every result"
      }
    }
  ],
  "handler": {
    "type": "template",
    "config": {
      "items": [
        "specific contribution",
        "audience impact supplied by user",
        "photo or recording link",
        "future invite"
      ]
    }
  },
  "guardrails": {
    "no_fabrication": true,
    "draft_only_for_generative_tools": true,
    "human_approval_required": true,
    "no_auto_send": true,
    "use_supplied_facts_only": true
  },
  "keywords": [
    "speakers & sponsors",
    "community",
    "template"
  ]
}
{
  "name": "event-idea-scorer",
  "display_name": "Event Idea Scorer",
  "description": "Score an event idea before committing a venue.",
  "category": "Events",
  "domain": "Community",
  "version": "1.0.0",
  "author": {
    "name": "Lionel Sim",
    "url": "https://sg.linkedin.com/in/lionelshen"
  },
  "license": "MIT",
  "tools": [
    {
      "name": "event_idea_scorer",
      "description": "Score an event idea before committing a venue.",
      "kind": "score",
      "inputSchema": {
        "type": "object",
        "properties": {
          "metrics": {
            "type": "object",
            "description": "Scores 0-100 keyed by: member_demand, speaker_availability, cost, sponsor_fit, format_novelty"
          }
        },
        "required": [
          "metrics"
        ]
      },
      "sample_input": {
        "metrics": {
          "member_demand": 70,
          "speaker_availability": 70,
          "cost": 70,
          "sponsor_fit": 70,
          "format_novelty": 70
        }
      },
      "output": {
        "plugin": "event-idea-scorer",
        "tool": "event_idea_scorer",
        "kind": "score",
        "result": "object (shape varies by kind, see README)",
        "guardrails": "object \u2014 present on every result"
      }
    }
  ],
  "handler": {
    "type": "score",
    "config": {
      "items": [
        "member demand",
        "speaker availability",
        "cost",
        "sponsor fit",
        "format novelty"
      ]
    }
  },
  "guardrails": {
    "no_fabrication": true,
    "draft_only_for_generative_tools": true,
    "human_approval_required": true,
    "no_auto_send": true,
    "use_supplied_facts_only": true
  },
  "keywords": [
    "events",
    "community",
    "score"
  ]
}
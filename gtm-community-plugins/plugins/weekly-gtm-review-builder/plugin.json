{
  "name": "weekly-gtm-review-builder",
  "display_name": "Weekly GTM Review Builder",
  "description": "Build a weekly GTM review from supplied metrics only.",
  "category": "Analytics & Learning",
  "domain": "GTM",
  "version": "1.0.0",
  "author": {
    "name": "Lionel Sim",
    "url": "https://sg.linkedin.com/in/lionelshen"
  },
  "license": "MIT",
  "tools": [
    {
      "name": "weekly_gtm_review_builder",
      "description": "Build a weekly GTM review from supplied metrics only.",
      "kind": "template",
      "inputSchema": {
        "type": "object",
        "properties": {
          "facts": {
            "type": "object",
            "description": "Supplied facts only, keys include: headline_metric, wins, losses, lessons, one_priority"
          }
        },
        "required": [
          "facts"
        ]
      },
      "sample_input": {
        "facts": {
          "headline_metric": "[supplied: headline metric]",
          "wins": "[supplied: wins]",
          "losses": "[supplied: losses]"
        }
      },
      "output": {
        "plugin": "weekly-gtm-review-builder",
        "tool": "weekly_gtm_review_builder",
        "kind": "template",
        "result": "object (shape varies by kind, see README)",
        "guardrails": "object \u2014 present on every result"
      }
    }
  ],
  "handler": {
    "type": "template",
    "config": {
      "items": [
        "headline metric",
        "wins",
        "losses",
        "lessons",
        "one priority"
      ]
    }
  },
  "guardrails": {
    "no_fabrication": true,
    "draft_only_for_generative_tools": true,
    "human_approval_required": true,
    "no_auto_send": true,
    "use_supplied_facts_only": true
  },
  "keywords": [
    "analytics & learning",
    "gtm",
    "template"
  ]
}